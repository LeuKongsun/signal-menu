# Telegram Bot Configuration
# 1. Talk to @BotFather on Telegram, send /newbot, and paste token here:
TELEGRAM_BOT_TOKEN=

# 2. Who receives new orders. One id, or several separated by commas.
#    Each private chat: that person must open the bot and tap Start first.
#    A group works too: add the bot, then use the group id (usually starts with -100).
#    Example: TELEGRAM_CHAT_ID=111111111,222222222,-1003333333333
TELEGRAM_CHAT_ID=

# Cafe ABA Bank Details
NEXT_PUBLIC_ABA_ACCOUNT_NAME=SIGNAL CAFE
NEXT_PUBLIC_ABA_ACCOUNT_NUMBER=000 123 456
NEXT_PUBLIC_ABA_PAY_LINK=https://pay.ababank.com/oRF8/ct9mjwy8
