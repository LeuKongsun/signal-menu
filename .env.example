# Telegram Bot Configuration
# 1. Talk to @BotFather on Telegram, send /newbot, and paste token here:
TELEGRAM_BOT_TOKEN=

# 2. Who receives new orders. One id, or several separated by commas.
#    Each private chat: that person must open the bot and tap Start first.
#    A group works too: add the bot, then use the group id (usually starts with -100).
#    Example: TELEGRAM_CHAT_ID=111111111,222222222,-1003333333333
TELEGRAM_CHAT_ID=

# 3. Any random string. Pass the same value as secret_token when calling setWebhook,
#    so only Telegram can press the order buttons.
TELEGRAM_WEBHOOK_SECRET=

# 4. Optional: the page the bot's "Order drinks" button opens. Defaults to the site root.
# TELEGRAM_MINI_APP_URL=https://your-domain.vercel.app/

# Order storage (Upstash Redis). On Vercel: Storage → Marketplace → Upstash for Redis,
# connect it to this project and these are filled in automatically.
# Leave empty locally to keep orders in memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Cafe ABA Bank Details
# Set to "false" to hide ABA KHQR checkout; cash on pickup is always available.
NEXT_PUBLIC_ABA_PAYMENT_ENABLED=true
NEXT_PUBLIC_ABA_ACCOUNT_NAME=SOLIKAH MAKARA
NEXT_PUBLIC_ABA_PAY_LINK=https://pay.ababank.com/oRF8/lyyuerfa
